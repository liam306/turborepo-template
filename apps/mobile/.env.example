# Backend API URL
EXPO_PUBLIC_API_URL=http://localhost:4000

# Storage Public URL (SeaweedFS / S3 / MinIO)
EXPO_PUBLIC_STORAGE_URL=http://localhost:8333/app-storage

# Sentry - Runtime Error Tracking
EXPO_PUBLIC_SENTRY_DSN=

# Sentry - Build-Time & EAS Source Maps Upload (Auto-skipped during build if SENTRY_ORG or SENTRY_PROJECT is omitted)
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_URL=https://sentry.io/

# OAuth (Google Client ID for mobile)

# PostHog Product Analytics & Session Replay
EXPO_PUBLIC_POSTHOG_API_KEY=
EXPO_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
