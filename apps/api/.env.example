# Backend Configuration
PORT=4000
NODE_ENV=development

# Database (PostgreSQL)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432
POSTGRES_DB=app_db
DATABASE_URL=postgres://postgres:postgres@localhost:5432/app_db

# Redis (Cache & BullMQ)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Better Auth
BETTER_AUTH_SECRET=dev_secret_key_change_me_in_prod
BETTER_AUTH_URL=http://localhost:4000
AUTH_TRUSTED_ORIGINS=starter://,starter-dev://,starter-preview://
# Domain for cross-subdomain cookies in production (e.g. .example.com)
COOKIE_DOMAIN=

# CORS Allowed Origins (Comma-separated list of domains)
CORS_ORIGINS=http://localhost:3000,http://localhost:8081

# Documentation & Admin Board Basic Auth
DOCS_USER=admin
DOCS_PASSWORD=admin@secret

# Admin Bootstrap & Super Admin Seed
ADMIN_BOOTSTRAP_TOKEN=
ADMIN_EMAIL=admin@example.local
ADMIN_NAME="Super Admin"
ADMIN_PASSWORD=

# Storage (S3 / SeaweedFS / Cloudflare R2)
STORAGE_DRIVER=s3
STORAGE_S3_ENDPOINT=http://localhost:8333
STORAGE_S3_REGION=us-east-1
STORAGE_S3_BUCKET=app-storage
STORAGE_S3_ACCESS_KEY_ID=minioadmin
STORAGE_S3_SECRET_ACCESS_KEY=minioadmin
STORAGE_S3_FORCE_PATH_STYLE=true
STORAGE_PUBLIC_URL_PREFIX=http://localhost:8333/app-storage

# OAuth (Optional for local dev)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=

# Mail (Mailpit for local dev, or Gmail/Resend for prod)
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_SECURE=false
MAIL_USER=mailpit
MAIL_PASS=mailpit
MAIL_FROM="Starter <noreply@example.local>"

# Mailpit Ports & UI Auth (docker-compose)
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
MAILPIT_UI_USER=admin
MAILPIT_UI_PASS=admin@mailpit

# Sentry Error Tracking (Optional)
SENTRY_DSN=
