# 1. PORT
APP_NAME=starter
API_PORT=4000
WEB_PORT=3000

# 2. Database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432
POSTGRES_DB=app_db
DATABASE_URL=postgres://postgres:postgres@localhost:5432/app_db

# 3. Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# 4. Better Auth Backend
BETTER_AUTH_SECRET=dev_secret_key_change_me_in_prod
BETTER_AUTH_URL=http://localhost:4000
AUTH_TRUSTED_ORIGINS=starter://,starter-dev://,starter-preview://
# Domain for cross-subdomain cookies in production (e.g. .example.com)
COOKIE_DOMAIN=

# 5. Docs & Bull Board Basic Auth
DOCS_USER=admin
DOCS_PASSWORD=admin@secret

# 5.1. Admin Bootstrap & Super Admin Seed
ADMIN_BOOTSTRAP_TOKEN=
ADMIN_EMAIL=admin@example.local
ADMIN_NAME="Super Admin"
ADMIN_PASSWORD=

# 5.2. CORS Allowed Origins
CORS_ORIGINS=http://localhost:3000,http://localhost:8081

# 5.3. Storage (S3 / Cloudflare R2 / SeaweedFS)
STORAGE_DRIVER=s3
STORAGE_S3_ENDPOINT=http://localhost:8333
STORAGE_S3_REGION=us-east-1
STORAGE_S3_BUCKET=app-storage
STORAGE_S3_ACCESS_KEY_ID=minioadmin
STORAGE_S3_SECRET_ACCESS_KEY=minioadmin
STORAGE_S3_FORCE_PATH_STYLE=true
STORAGE_PUBLIC_URL_PREFIX=http://localhost:8333/app-storage
SEAWEEDFS_S3_PORT=8333
SEAWEEDFS_FILER_PORT=8888

# 6. Frontend & Mobile Public Vars
NEXT_PUBLIC_API_URL=http://localhost:4000
EXPO_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_STORAGE_URL=http://localhost:8333/app-storage
EXPO_PUBLIC_STORAGE_URL=http://localhost:8333/app-storage

# 7. Mail (Mailpit for local dev)
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_SECURE=false
MAIL_USER=mailpit
MAIL_PASS=mailpit
MAIL_FROM="Starter <noreply@example.local>"

# 7.1. Mailpit Ports & UI Auth (docker-compose)
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
MAILPIT_UI_USER=admin
MAILPIT_UI_PASS=admin@mailpit

# 8. OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=

# 9. Sentry Error Tracking & Monitoring
# Backend NestJS API DSN
SENTRY_DSN=
# Web Next.js DSN
NEXT_PUBLIC_SENTRY_DSN=
# Mobile Expo DSN
EXPO_PUBLIC_SENTRY_DSN=
# Sentry Auth Token
SENTRY_AUTH_TOKEN=

# 10. PostHog Product Analytics & Session Replay
POSTHOG_API_KEY=
POSTHOG_HOST=https://us.i.posthog.com
