{
  "name": "@repo/mobile",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "dependencies": {
    "@better-auth/expo": "1.7.7",
    "@expo/ui": "~57.0.21",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@repo/core": "workspace:*",
    "@repo/types": "workspace:*",
    "@repo/utils": "workspace:*",
    "@sentry/react-native": "~7.11.0",
    "@tanstack/react-query": "^5.104.1",
    "axios": "^1.20.0",
    "better-auth": "1.7.7",
    "clsx": "^2.1.1",
    "expo": "~57.0.26",
    "expo-apple-authentication": "~57.0.2",
    "expo-asset": "~57.0.18",
    "expo-constants": "~57.0.20",
    "expo-crypto": "~57.0.3",
    "expo-dev-client": "~57.0.19",
    "expo-font": "~57.0.4",
    "expo-glass-effect": "~57.0.4",
    "expo-image": "~57.0.5",
    "expo-image-picker": "~57.0.20",
    "expo-linking": "~57.0.11",
    "expo-localization": "^57.0.2",
    "expo-network": "~57.0.2",
    "expo-router": "~57.0.24",
    "expo-secure-store": "~57.0.4",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.3",
    "expo-system-ui": "~57.0.4",
    "expo-updates": "~57.0.24",
    "expo-web-browser": "~57.0.3",
    "i18next": "^26.4.2",
    "lucide-react-native": "^1.50.0",
    "nativewind": "^4.2.7",
    "posthog-react-native": "^4.78.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-i18next": "^17.0.15",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-toast-message": "^2.5.2",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^3.4.17",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@types/react": "~19.2.2",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~57.0.2",
    "jsdom": "^26.1.0",
    "typescript": "~6.0.3",
    "vitest": "^5.0.3"
  },
  "scripts": {
    "start": "expo start",
    "dev": "expo start --dev-client",
    "dev:wsl": "bash ./scripts/start-wsl.sh",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "test": "vitest run --maxWorkers=2",
    "test:unit": "vitest run --maxWorkers=2",
    "test:cov": "vitest run --coverage --maxWorkers=2",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "bundle:check": "pnpm bundle:check:android && pnpm bundle:check:ios",
    "bundle:check:android": "expo export -p android --no-bytecode --output-dir /tmp/antigravity/expo-export-android",
    "bundle:check:ios": "expo export -p ios --no-bytecode --output-dir /tmp/antigravity/expo-export-ios",
    "build:android:dev": "APP_ENV=development eas build -p android --profile development",
    "build:android:preview": "APP_ENV=preview eas build -p android --profile preview",
    "build:android:prod": "APP_ENV=production eas build -p android --profile production",
    "build:ios:dev": "APP_ENV=development eas build -p ios --profile development",
    "build:ios:preview": "APP_ENV=preview eas build -p ios --profile preview",
    "build:ios:prod": "APP_ENV=production eas build -p ios --profile production",
    "build:android:dev:submit": "APP_ENV=development eas build -p android --profile development --auto-submit",
    "build:android:preview:submit": "APP_ENV=preview eas build -p android --profile preview --auto-submit",
    "build:android:prod:submit": "APP_ENV=production eas build -p android --profile production --auto-submit",
    "build:ios:dev:submit": "APP_ENV=development eas build -p ios --profile development --auto-submit",
    "build:ios:preview:submit": "APP_ENV=preview eas build -p ios --profile preview --auto-submit",
    "build:ios:prod:submit": "APP_ENV=production eas build -p ios --profile production --auto-submit",
    "build:all:dev:submit": "APP_ENV=development eas build -p all --profile development --auto-submit",
    "build:all:preview:submit": "APP_ENV=preview eas build -p all --profile preview --auto-submit",
    "build:all:prod:submit": "APP_ENV=production eas build -p all --profile production --auto-submit",
    "submit:android:dev": "APP_ENV=development eas submit -p android --profile development",
    "submit:android:preview": "APP_ENV=preview eas submit -p android --profile preview",
    "submit:android:prod": "APP_ENV=production eas submit -p android --profile production",
    "submit:ios:dev": "APP_ENV=development eas submit -p ios --profile development",
    "submit:ios:preview": "APP_ENV=preview eas submit -p ios --profile preview",
    "submit:ios:prod": "APP_ENV=production eas submit -p ios --profile production",
    "update:preview": "APP_ENV=preview eas update --branch preview --environment preview --message 'Update preview'",
    "update:prod": "APP_ENV=production eas update --branch production --environment production --message 'Update production'"
  },
  "private": true
}
