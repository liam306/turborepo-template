# Web Server Port
WEB_PORT=3000

# Backend API URL
NEXT_PUBLIC_API_URL=http://localhost:4000

# Storage Public URL (SeaweedFS / S3 / MinIO)
NEXT_PUBLIC_STORAGE_URL=http://localhost:8333/app-storage

# Sentry - Runtime Error Tracking (Client & Server)
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_RELEASE=

# Sentry - Build-Time & Source Maps Upload (CI / BuildKit Only - Never bake token into image)
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_RELEASE=
SENTRY_URL=https://sentry.io/

# PostHog Product Analytics & Session Replay
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
