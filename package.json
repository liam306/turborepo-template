{
  "name": "turbo-monorepo-template",
  "private": true,
  "packageManager": "pnpm@11.6.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "turbo test --concurrency=2",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "dev:mobile": "pnpm --filter @repo/mobile dev",
    "dev:mobile:wsl": "pnpm --filter @repo/mobile dev:wsl",
    "dev:mobile:ios": "pnpm --filter @repo/mobile ios",
    "dev:mobile:android": "pnpm --filter @repo/mobile android",
    "dev:mobile:web": "pnpm --filter @repo/mobile web",
    "lint:mobile": "pnpm --filter @repo/mobile lint",
    "typecheck:mobile": "pnpm --filter @repo/mobile typecheck",
    "dev:web": "pnpm --filter @repo/web dev",
    "build:web": "pnpm --filter @repo/web build",
    "start:web": "pnpm --filter @repo/web start",
    "lint:web": "pnpm --filter @repo/web lint",
    "typecheck:web": "pnpm --filter @repo/web typecheck",
    "test:web": "pnpm --filter @repo/web test",
    "test:e2e:web": "pnpm --filter @repo/web test:e2e",
    "dev:api": "pnpm --filter @repo/api dev",
    "build:api": "pnpm --filter @repo/api build",
    "start:api": "pnpm --filter @repo/api start",
    "lint:api": "pnpm --filter @repo/api lint",
    "typecheck:api": "pnpm --filter @repo/api typecheck",
    "test:api": "pnpm --filter @repo/api test",
    "test:cov:api": "pnpm --filter @repo/api test:cov",
    "mobile:build:android:dev": "pnpm --filter @repo/mobile build:android:dev",
    "mobile:build:android:preview": "pnpm --filter @repo/mobile build:android:preview",
    "mobile:build:android:prod": "pnpm --filter @repo/mobile build:android:prod",
    "mobile:build:ios:dev": "pnpm --filter @repo/mobile build:ios:dev",
    "mobile:build:ios:preview": "pnpm --filter @repo/mobile build:ios:preview",
    "mobile:build:ios:prod": "pnpm --filter @repo/mobile build:ios:prod",
    "mobile:update:preview": "pnpm --filter @repo/mobile update:preview",
    "mobile:update:prod": "pnpm --filter @repo/mobile update:prod",
    "docker:up": "docker compose -f docker-compose-local.yml up -d",
    "docker:down": "docker compose -f docker-compose-local.yml down",
    "docker:logs": "docker compose -f docker-compose-local.yml logs -f",
    "db:push": "pnpm --filter @repo/database db:push",
    "db:generate": "pnpm --filter @repo/database db:generate",
    "db:migrate": "pnpm --filter @repo/database db:migrate",
    "db:studio": "pnpm --filter @repo/database db:studio",
    "seed:admin": "pnpm --filter @repo/api seed:admin",
    "env:sync": "node scripts/sync-env.mjs",
    "env:sync:dev": "node scripts/sync-env.mjs -e development",
    "env:sync:staging": "node scripts/sync-env.mjs -e staging",
    "env:sync:prod": "node scripts/sync-env.mjs -e production",
    "check:i18n": "node scripts/check-i18n.mjs",
    "check:rules": "node scripts/check-codebase-rules.mjs",
    "check:hardcoded": "node scripts/check-hardcoded-text.mjs",
    "check:renovate": "pnpm dlx --package renovate renovate-config-validator --strict --no-global renovate.json",
    "test:scripts": "node --test --test-concurrency=2 scripts/tests/*.test.mjs",
    "lint:scripts": "eslint --config scripts/eslint.config.mjs scripts/**/*.mjs",
    "typecheck:scripts": "tsc --noEmit --allowJs --checkJs --module nodenext --target es2022 scripts/check-hardcoded-text.mjs scripts/check-codebase-rules.mjs scripts/lib/*.mjs scripts/lib/codebase-rules/*.mjs",
    "check:i18n:api": "node scripts/check-i18n.mjs api",
    "check:i18n:web": "node scripts/check-i18n.mjs web",
    "check:i18n:mobile": "node scripts/check-i18n.mjs mobile"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.20.4",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "turbo": "^2.11.7",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.0"
  }
}
